---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <Header />
        <main>
            <p>Welcome to my little corner of the internet!</p>

            <p>
                My name is Joel and I come from a background of game development. After that I
                learned web development and now I work with Kubernetes, linux servers and all things
                related to containers.
            </p>

            <p>
                I like to tinker with computers, electronics and woodworking. Join me on my journey
                and follow my blog to see what projects I'm working on.
            </p>
        </main>
        <Footer />
    </body>
</html>
