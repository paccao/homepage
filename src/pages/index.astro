---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <Header />
        <main>
            <p>Welcome to my corner of the internet!</p>

            <p>
                My name is Joel and I'm a system developer from Sweden. I come
                from a background in web development but now I mainly focus on
                DevSecOps, linux and all things related to containers.
            </p>

            <p>
                I like to tinker with computers, electronics and woodworking. I
                plan on writing blog posts and eventually add more content to
                this site to showcase what I'm working on.
            </p>

            <p>
                If you find this interesting, consider subscribing to my blog
                using an RSS reader of your choice.
            </p>
        </main>
        <Footer />
    </body>
</html>
